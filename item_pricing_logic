    }
items_prices = {
'meat': 250,
'chicken': 140,
'bread': 10,
'chocolate': 20,
'milks': 42,
'butter': 75,
'nuts': 90,
'cheese': 65,
'yoghurt': 25,
'eggs': 120
}
all_shobing = {}
for items in february_shopping_list.values():
    for object in items :
        if object in all_shobing :
            all_shobing [object] += 1
        else:
            all_shobing[object] = 1
item_price = {}
for item , price in items_prices.items():
    item_price[item] = (price * all_shobing[item])

for item , count in all_shobing.items() :
    print(f"{item.title()} : {count}")

print("-"*20)

for item , cost in item_price.items() :
    print(f"{item.title()} : {cost}")

total_cost = sum(item_price.values())
print("-"*20)
print(f"Total items cost is : {total_cost}")
