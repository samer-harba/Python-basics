employees = { 
    "Mohamed Hassan": {"age": 25, "salary": 5000, "department": 
"HR"}, 
    "Ahmed Kamal": {"age": 30, "salary": 6000, "department": 
"IT"}, 
    "Ali Adel": {"age": 35, "salary": 7000, "department": 
"IT"}, 
    "Hossam Yehia": {"age": 40, "salary": 8000, "department": 
"IT"} 
}
while True:
    inp = input("Enter employee name (press enter to exit) : ")
    if inp == "":
        break

    employee = employees.get(inp,"Not Available")

    if inp in employees:
        print(f"Employee : {inp}\n"
              f"Age : {employee["age"]}\n"
              f"Salary : {employee["salary"]}\n"
              f"Department : {employee["department"]}")
    else:
        print(employee)
