# A dictionary of available items 
available_items = { 
    "Google Pixel 6a": { 
        "price": 280, 
        "quantity": 5 
    }, 
    "SAMSUNG Galaxy S23 Ultra": { 
        "price": 1200, 
        "quantity": 3 
    }, 
    "iPhone 13 Pro Max": { 
        "price": 1300, 
        "quantity": 2 
    }, 
    "Xiaomi Redmi 9A": { 
        "price": 100, 
        "quantity": 4 
    }, 
    "Huawei P50 Pro": { 
        "price": 1000, 
        "quantity": 1 
    }, 
    "OnePlus 9 Pro": { 
        "price": 800, 
        "quantity": 1 
    }, 
}
print("Welcome to samer store !!")
cart = {}
while True :
    print("What would you like to do ? \n"
          "1. view available items\n"
          "2. view cart\n"
          "3. total cart price\n"
          "4. clear cart\n"
          "5. quit".capitalize())
    user_choice = input("Enter the number of your choice : ")
    if user_choice == "1" :
        print("Available items are :")
        for i,item in enumerate(available_items) :
            item_price = available_items[item]["price"]
            if available_items[item]["quantity"] != 0 :
                print(f"{i+1}. {item} : {item_price}$")
            else:
                print(f"{i+1}. {item} : {item_price}$ ..(Not available)..")

        item_num = int(input("Enter the number of the item you want ot purchase (Enter 0 to return to previous menu) : "))
        if item_num == 0:
            continue
        order_name = list(available_items.keys())[item_num - 1]
        order_price = available_items[order_name]["price"]
        order_quantity = int(input("Pleas, Enter the quantity : "))
        if order_quantity > available_items[order_name]["quantity"] :
            print(f"Sorry, We only have {available_items[order_name]["quantity"]} of this item .")
        else:
            order_info = {order_name : {"price" : order_price , "quantity" : order_quantity}}
            cart.update(order_info)
            available_items[order_name]["quantity"] -= order_quantity
            print(f"{order_name} has been added to the cart successfully .")
    elif user_choice == "2" :
        print("Cart :")
        print("-"*20)
        for item in cart :
            item_price = cart[item]["price"]
            item_quantity = cart[item]["quantity"]
            total_price_item = item_price * item_quantity
            print(f"{item} : ${item_price} x {item_quantity} = ${total_price_item:,}")
        print("-"*20)
        total_cart_price = [cart[item]["price"] * cart[item]["quantity"] for item in cart]
        print(f"Total cart price : ${sum(total_cart_price)}")
    elif user_choice == "3" :
        total_cart_price = [cart[item]["price"] * cart[item]["quantity"] for item in cart]
        print("-" * 20)
        print(f"Total cart price : ${sum(total_cart_price)}")
    elif user_choice == "4" :
        answer = input("Are you sure you want to clear the cart ? ( y / n ) : ")
        if answer == "y" :
            cart = {}
            print("Cart has been cleared successfully.")
        else:
            continue
    elif user_choice == "5" :
        break
    else:
        print("Invalid option")

print("Cart :")
print("-"*20)
for item in cart :
    item_price = cart[item]["price"]
    item_quantity = cart[item]["quantity"]
    total_price_item = item_price * item_quantity
    print(f"{item} : ${item_price} x {item_quantity} = ${total_price_item:,}")
print("-"*20)
total_cart_price = [cart[item]["price"] * cart[item]["quantity"] for item in cart]
print(f"Total cart price : ${sum(total_cart_price)}")
print("-"*20)
print("-"*20)
print("Welcome in samer store !!")
