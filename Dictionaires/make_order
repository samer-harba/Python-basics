 # available items
hot_drinks = {"Coffee": 20, "Tea": 15, "Hot Chocolate": 25}
cold_drinks = {"Soda": 10, "Iced Tea": 15, "Smoothie": 30}
desserts = {"Ice Cream": 50, "Chocolate Cake": 60,
"Cheesecake": 70}
menu = {"hot drinks":hot_drinks, "cold drinks" : cold_drinks, "desserts" : desserts}
print("Welcome to samer cafe !!")
order = {}
while True:
    for i , item in enumerate(menu):
        print(f"{i+1}. {item}".title())
    choice = input("Pleas , Enter your choice (Enter to exit) : ")
    if choice == "":
        break
    item_type_name = list(menu)[int(choice)-1]
    item_type = menu[item_type_name]
    for i , item in enumerate(item_type):
        item_prise = item_type[item]
        print(f"{i+1}. {item} : {item_prise} EGP")
    choice = input("Pleas , Enter your choice : ")
    item_name = list(item_type)[int(choice) - 1 ]
    item_quantity = int(input("Enter quantity item : "))
    item_prise = item_type[item_name]
    item_total = item_quantity * item_prise
    order[item_name] = {"name" : item_name, "quantity":item_quantity , "prise" : item_prise , "total" : item_total}

total_of_orders = [order[item]["total"] for item in order]
prise_of_orders = sum(total_of_orders)

print("-"*20)
print("Your order is : ")
print("-"*20)
for item in order:
    print(f'''
item :{order[item]["name"]}
prise : {order[item]["prise"]} 
quantity : {order[item]["quantity"]}
total : {order[item]["total"]}
'''.title())
    print("-"*20)
print(f"total order : {prise_of_orders}".title())
